# ============================================
# 阿里云部署环境变量模板
# 使用方式：cp .env.example .env 然后修改为实际值
# ============================================

# ---- 数据库（阿里云 RDS MySQL / ECS 自建 MySQL）----
# 先在 RDS 控制台创建数据库（建议库名 new-api，字符集 utf8mb4）和专用账号
# 格式: user:password@tcp(host:port)/dbname?charset=utf8mb4&parseTime=true
# 注意:
#   1. ECS 与 RDS 同地域时填【内网地址】，如 rm-xxxxxxx.mysql.rds.aliyuncs.com（免公网流量费）
#   2. 若 ECS 自建 MySQL，填 ECS 内网 IP
#   3. 密码包含 @ : / 等特殊字符时，必须做 URL 转义（@ -> %40, : -> %3A）
#   4. RDS 白名单需放行 ECS 内网 IP（或 0.0.0.0/0 测试用，生产不推荐）
SQL_DSN=your_user:your_password@tcp(rm-xxxxxxx.mysql.rds.aliyuncs.com:3306)/new-api?charset=utf8mb4&parseTime=true

# ---- Redis（Compose 内置容器，需设置强密码）----
REDIS_PASSWORD=change-me-redis-password

# ---- 会话密钥（多实例/重启保持登录必须一致，务必改为随机长字符串）----
# 生成方式: openssl rand -hex 32
SESSION_SECRET=change-me-session-secret

# ---- 服务端口（阿里云安全组需放行该端口 TCP 入方向）----
PORT=3000

# ---- 节点名称（审计日志标识）----
NODE_NAME=new-api-node-1
