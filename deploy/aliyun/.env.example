# ============================================
# new-api 后端环境变量（systemd 读取，位于 /opt/new-api/.env）
# 使用：cp .env.example .env 然后修改为实际值
# 注意：systemd 的 EnvironmentFile 不支持行内注释，
#       建议使用 `key=value` 格式，等号后无引号
# ============================================

# ---- 服务端口（后端仅监听内网，由 Nginx 反代对外）----
PORT=4340

# ---- Gin 运行模式：release 关闭调试日志 ----
GIN_MODE=release

# ---- 时区 ----
TZ=Asia/Shanghai

# ---- 数据库 ----
# 不设置 SQL_DSN 则使用 SQLite（默认存 /opt/new-api 下的 new-api.db）
# 使用 MySQL（阿里云 RDS）时取消注释并填写：
# 格式: user:password@tcp(host:port)/dbname?charset=utf8mb4&parseTime=true
# 密码含特殊字符需 URL 转义（@ -> %40, : -> %3A）
#SQL_DSN=your_user:your_password@tcp(rm-xxxx.mysql.rds.aliyuncs.com:3306)/new-api?charset=utf8mb4&parseTime=true

# ---- Redis（可选，建议生产启用）----
#REDIS_CONN_STRING=redis://:your_password@127.0.0.1:6379

# ---- 会话密钥（登录持久化，务必改为随机长字符串）----
# 生成方式: openssl rand -hex 32
SESSION_SECRET=change-me-session-secret

# ---- 节点名称（多实例时区分）----
NODE_NAME=new-api-node-1
