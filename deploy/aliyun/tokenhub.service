# ============================================================
# 零一云 (TokenHub) systemd 服务文件（后端 API 服务）
# 安装方式：
#   cp tokenhub.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now tokenhub
# ============================================================

[Unit]
Description=TokenHub - AI Aggregation Platform (Backend API)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root

# 工作目录：后端二进制所在目录
WorkingDirectory=/web/01tokenhub/new-api

# 启动命令：二进制路径 + 参数
ExecStart=/web/01tokenhub/new-api/new-api --log-dir /web/01tokenhub/new-api/logs
ExecReload=/bin/kill -s HUP $MAINPID

# 守护进程配置
Restart=always
RestartSec=5
StartLimitIntervalSec=0

# 环境变量（优先使用 EnvironmentFile，避免硬编码敏感信息）
EnvironmentFile=-/web/01tokenhub/new-api/.env
# 基础环境变量兜底
Environment=PORT=4340
Environment=GIN_MODE=release
Environment=TZ=Asia/Shanghai

# 资源限制
LimitNOFILE=65535
NoNewPrivileges=false

# 日志输出到 journald，可通过 journalctl 查看
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
